# Copy this example to .env.test.local (ignored); never copy .env.local.
# Supply all six values from the disposable test project only.
# Existing process variables must agree with this file or execution is refused.
TEST_SUPABASE_URL=https://PROJECT-REF.supabase.co
TEST_SUPABASE_ANON_KEY=replace-me
TEST_SUPABASE_SERVICE_ROLE_KEY=replace-me
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Synthetic persistent admin; never use a real address or operational password.
TEST_ADMIN_EMAIL=admin-test@example.invalid
TEST_ADMIN_PASSWORD=replace-me

# Optional (Fase 6B.4). Only "fake" or "fake-error" have any effect, and only in this same
# authorized process (see lib/server/ai/aiProvider.ts) — never set this in .env.local.
# fake       -> import/analyze* and difficulty classification return a deterministic fixture.
# fake-error -> same, but simulates an AI failure. No network call to OpenAI is ever made.
TEST_AI_MODE=fake
